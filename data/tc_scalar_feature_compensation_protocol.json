  "exact_mathematical_object": {
    "domain": "Y in R, Y >= 2",
    "window_inner_product": "<f, g>_Y = int_Y^{tau*Y} f(X)*g(X) dX/X on H_scalar,Y = L^2([Y, tau*Y], dX/X)",
    "feature_hilbert_space": "H_feature,Y = bigoplus_{(p, k) : p^k <= T(Y)} L^2([Y, tau*Y], dX/X)",
    "canonical_cutoffs": {
      "T_Y": "ceil(Y^(5/4))",
      "D0_Y": "floor(log Y)",
      "D_eff_Y": "min(D0(Y), T(Y) - 1)",
      "sqrt_T_Y": "floor(sqrt(T(Y)))"
    },
    "complete_observables": {
      "U_Y": "sum_{a in C(T(Y))} mu(a) * A_a = sum_{n in Omega_2(T(Y))} lambda(n) * psi_{Y, n}",
      "V_Y": "(sum_{a in C(T(Y))} mu(a) * B_{a, (p,k)}^feat)_{p^k <= T(Y)} = (sum_{n in Omega_2(T(Y))} lambda(n) * g_{n, (p,k)})_{p^k <= T(Y)}",
      "J_A_Y": "sum_{a in C(T(Y))} ||A_a||_Y^2",
      "J_B_Y": "sum_{a in C(T(Y))} ||B_a^feat||_Y^2",
      "damped_core_defect_Y": "D_core(Y) := S_core^scal(Y) - 4*||V_Y||_Y^2 = ||U_Y||_Y^2 - 4*||V_Y||_Y^2 - J_A(Y) = S_core(Y) - 4*J_B(Y)",
      "key_disambiguation": "The artifact key damped_core_defect_Y denotes D_core(Y) = ||U_Y||_Y^2 - 4*||V_Y||_Y^2 - J_A(Y). It is strictly distinct from the inherited TC-064 artifact key D_core_Y, which denotes the core Gram diagonal sum_a (||A_a||_Y^2 - 4*||B_a^feat||_Y^2).",
      "paired_station_support_Omega2": "{n in [1, T] : Odd(v_2(n)) or 2*n <= T}",
      "paired_cutoff_fringe_Phi2": "{n in [1, T] : Even(v_2(n)) and T < 2*n}"
    }
  },
