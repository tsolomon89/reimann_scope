  "exact_mathematical_object": {
    "domain": "Y in R, Y >= 2",
    "window_inner_product": "<f, g>_Y = int_Y^{tau*Y} f(X)*g(X) dX/X",
    "canonical_cutoffs": {
      "T_Y": "ceil(Y^(5/4))",
      "D0_Y": "floor(log Y)",
      "effective_small_divisor_cutoff": "min(D0(Y), T(Y) - 1)"
    },
    "squarefree_core_definitions": {
      "O_T": "{u >= 1 : u odd and 2*u <= T}",
      "J_u_T": "{j >= 0 : 2 * 4^j * u <= T}",
      "C_T": "{a >= 1 : a odd squarefree and 2*a <= T}",
      "B_a_T": "{b >= 1 : b odd and 2 * a * b^2 <= T}",
      "Ucal_u": "sum_{j in J_u(T)} (psi_{Y, 4^j * u} - psi_{Y, 2 * 4^j * u})",
      "Vcal_u": "sum_{j in J_u(T)} (G_{4^j * u} - G_{2 * 4^j * u})",
      "A_a": "sum_{b in B_a(T)} Ucal_{a * b^2}",
      "Bfeature_a": "sum_{b in B_a(T)} Vcal_{a * b^2}",
      "S_core_Y": "sum_{a != c in C(T)} mu(a)*mu(c)*(<A_a, A_c>_Y - 4*<Bfeature_a, Bfeature_c>_Y)",
      "R_square_Y": "sum_{a in C(T)} (||A_a||_Y^2 - 4*||Bfeature_a||_Y^2) - sum_{u in O(T)} (||Ucal_u||_Y^2 - 4*||Vcal_u||_Y^2) (using displayed Gram diagonals, NEVER literal full-kernel diagonal values)",
      "complete_kernel_split": "S_different(Y) = R_square(Y) + S_core(Y)",
      "D_tilde_Y": "inherited grouped prime-power diagonal (sum over multiples q^a | n BEFORE squaring)"
    }
  },
  "full_closure_target_and_same_core_reduction": {
    "inherited_target_id": "TC063-OBL-DISTINCT-ODD-CHAIN-CORRELATION",
    "proved_same_core_bound": "sum_{a in C(T(Y))} (||A_a||_Y^2 + ||Bfeature_a||_Y^2) <= C_core*(1 + log Y) and |R_square(Y)| <= C_square*(1 + log Y) for all real Y >= 2",
